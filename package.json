{
  "name": "ecommerce-store",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack E-Commerce Store with Mini Inventory & Cart (React + Bootstrap + Node/Express + MongoDB)",
  "workspaces": ["server", "client"],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "dev": "concurrently -n SERVER,CLIENT -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "seed": "npm --workspace server run seed",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
